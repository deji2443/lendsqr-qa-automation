            "exec": [
              "// Validation for HTTP status code",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Validation for response message",
              "pm.test(\"Response status is success\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"success\");",
              "    pm.expect(jsonData.message).to.eql(\"Successful\");",
              "});",
              "",
              "// Senior Master level: Data Integrity Check",
              "pm.test(\"Bank data is not empty\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.be.an('array').that.is.not.empty;",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
