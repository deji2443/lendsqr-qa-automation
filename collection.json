    {
      "name": "BVN Consent",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Validation for the HTTP status code",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// 2. Validation for the specific OTP response (Fintech Flow)",
              "pm.test(\"Response status is 'otp'\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"otp\");",
              "    pm.expect(jsonData.message).to.include(\"OTP sent\");",
              "});",
              "",
              "// 3. Data Integrity Check (Masked Data)",
              "pm.test(\"Data contains masked contact info\", function () {",
              "    var jsonData = pm.response.json();",
              "    // Verify the data returned contains '*' which indicates masking for security",
              "    pm.expect(jsonData.data).to.include(\"*\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
